### GET users
GET {{baseUrl}}/api/user?limit=10&username=john.doe&name=test
Accept: application/json
Authorization: {{token}}

### Get single user
GET {{baseUrl}}/api/user/1
Accept: application/json
Authorization: {{token}}

### Create user
POST {{baseUrl}}/api/user
Content-Type: application/json
Authorization: {{token}}

{
    "username": "john.doe",
    "email": "john.doe@access.co.tz",
    "name": "John Doe"
}

### Update user
PUT {{baseUrl}}/api/user/3
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "name": "Updated Name",
  "email": "updated.email@example.com",
  "is_active": true
}

### Deactivate user
POST {{baseUrl}}/api/user/3/deactivate
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

### Activate user
POST {{baseUrl}}/api/user/3/activate
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

### Tokens request
POST {{baseUrl}}/oauth/token
Content-Type: application/json

{
    "grant_type": "password",
    "client_id": "0198861c-bcec-7322-8e35-c64f64913de5",
    "client_secret": "G0r9EWnALDLXW6HGcnfJCX75EWDzHQUf0v7BuXpS",
    "username": "testuser",
    "password": "password",
    "scope": "*"
}

### GET authenticated user
GET {{baseUrl}}/api/auth/user
Accept: application/json

### Refresh tokens request
POST {{baseUrl}}/api/auth/refresh-token
Content-Type: application/json

{
    "refreshToken": ""
}
