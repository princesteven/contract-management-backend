### GET users without filters
GET {{baseUrl}}/api/user
Accept: application/json
Authorization: {{token}}

### GET users with filters
GET {{baseUrl}}/api/user?limit=10&username=john.doe
Accept: application/json
Authorization: {{token}}

### Get single user with roles
GET {{baseUrl}}/api/user/3
Accept: application/json
Authorization: {{token}}

### Create user with roles
POST {{baseUrl}}/api/user
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "name": "Esau Doe",
  "username": "esau.doe",
  "email": "esau.doe@example.com",
  "roles": [1, 2]
}

### Update user with roles
PUT {{baseUrl}}/api/user/5
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "roles": [4]
}

### Update user without roles (won't change roles)
PUT {{baseUrl}}/api/user/5
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
  "name": "Juma Nature",
  "email": "juma.nature@example.com",
  "is_active": false
}

### Deactivate user
POST {{baseUrl}}/api/user/5/deactivate
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

### Activate user
POST {{baseUrl}}/api/user/5/activate
Content-Type: application/json
Accept: application/json
Authorization: {{token}}
